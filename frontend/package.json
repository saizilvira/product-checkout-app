    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.5",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
